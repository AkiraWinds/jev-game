TYPESAFE_API_KEY=
OPENAI_API_KEY=

# Optional overrides. GENERATOR_MODEL, JUDGE_SLM_MODEL, and JUDGE_LLM_MODEL
# must all be different models: no judge should grade text written by its
# own weights.
JEV_MODEL=jev-latest
GENERATOR_MODEL=gpt-4.1
JUDGE_SLM_MODEL=gpt-4.1-nano
JUDGE_LLM_MODEL=gpt-4.1
SCENARIOS_PATH=scenarios.json
